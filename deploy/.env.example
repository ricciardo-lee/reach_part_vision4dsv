# Copy to deploy/.env on the server. git pull does not overwrite this file.

APP_NAME=Reach Part Vision
APP_ENV=production
DEBUG=false
SECRET_KEY=replace-with-a-long-random-string
# Public origins of the H5 site and the admin site.
CORS_ORIGINS=["http://SERVER_HOST","http://SERVER_HOST:8080"]

# Company MySQL. Inside a container, 127.0.0.1 is the container itself.
# Use the database host's LAN address, or host.docker.internal when MySQL runs on this server.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=admin
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=reach_part_vision4dsv

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_ENABLED=true
CELERY_ALLOW_INLINE_FALLBACK=false
CELERY_WORKER_CONCURRENCY=1

# production + auto would try MinIO. This server stores files on the uploads volume.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/data/uploads

DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2

MDM_QUERY_BASE_URL=http://host.docker.internal:8010
MDM_CLIENT_ID=
MDM_CLIENT_SECRET=
MDM_USE_MOCK=false
MDM_VEHICLE_TYPE=passenger

RETRIEVAL_ENABLED=true
EMBEDDING_BACKEND=dinov2
EMBEDDING_MODEL_ID=facebook/dinov2-base
VECTOR_BACKEND=memory
SEARCH_INDEX_DIR=/data/indexes
# Optional second dump. Foreground queries use it; full-frame fallback keeps SEARCH_INDEX_DIR.
SEARCH_WHITE_INDEX_DIR=
SEARCH_AGGREGATE=topm_mean
SEARCH_TOPM=3
SEARCH_PER_IMAGE_TOP_K=30
SEARCH_HIGH_SCORE=0.72
SEARCH_MEDIUM_SCORE=0.55
SEARCH_MIN_MARGIN=0.03
SEARCH_CATEGORY_MIN_SCORE=0.55
SEARCH_CATEGORY_TOP_N=5
SEARCH_CATEGORY_RELATIVE_FLOOR=0.85
SEARCH_VISION_CATEGORY_MIN_CONFIDENCE=0.6
SEARCH_ENABLE_DUAL_PATH=false
SEARCH_TARGET_SIZE=224
SEARCH_ENABLE_FOREGROUND=true
SEARCH_SEGMENT_ENABLED=true
SEARCH_MATTING_MODEL_ID=ZhengPeng7/BiRefNet
SEARCH_MATTING_INPUT_SIZE=1024
SEARCH_SEGMENT_DEVICE=cpu
HF_HOME=/data/models

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-admin-password
ADMIN_DISPLAY_NAME=系统管理员

# Host ports published by Nginx.
H5_PORT=80
ADMIN_PORT=8080

# CPU wheels from the Tsinghua PyTorch mirror. Other packages use the Tsinghua PyPI mirror.
# After a GPU is installed, point this at the matching CUDA index and rebuild the backend image.
# TORCH_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/pytorch-wheels/cu124
TORCH_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/pytorch-wheels/cpu
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
IMAGE_TAG=local
