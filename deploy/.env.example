# Copy to deploy/.env on the server. git pull does not overwrite this file.

APP_NAME=Reach Part Vision
APP_ENV=production
DEBUG=false
SECRET_KEY=replace-with-a-long-random-string
# Public origins of the H5 site, admin site, and desktop web site.
CORS_ORIGINS=["http://SERVER_HOST","http://SERVER_HOST:8080","http://SERVER_HOST:8081"]

# Company MySQL. Inside a container, 127.0.0.1 is the container itself.
# Use the database host's LAN address, or host.docker.internal when MySQL runs on this server.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=admin
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=reach_part_vision4dsv

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_ENABLED=true
CELERY_ALLOW_INLINE_FALLBACK=false
CELERY_WORKER_CONCURRENCY=1

# production + auto would try MinIO. This server stores files on the uploads volume.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/data/uploads

# OpenAI-compatible vision/chat (default: OpenAI). Names stay DEEPSEEK_* for compatibility.
DEEPSEEK_API_KEY=sk-your-openai-api-key
DEEPSEEK_BASE_URL=https://api.openai.com/v1
DEEPSEEK_MODEL=gpt-4o
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_CHAT_MODEL=gpt-4o
DEEPSEEK_CHAT_MAX_TOOL_ROUNDS=4

# Meta WhatsApp Cloud API (gateway forwards :5001/sms/whatsapp/<token> → api:8000)
WHATSAPP_ENABLED=true
WHATSAPP_WEBHOOK_PATH_TOKEN=3ffcb52b3d3140c6933dde80b43cafa8
WHATSAPP_VERIFY_TOKEN=reach-use
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_RATE_LIMIT_PER_MINUTE=10
WHATSAPP_CONTEXT_MESSAGES=20
WHATSAPP_CONVERSATION_IDLE_HOURS=24
WHATSAPP_IMAGE_DEBOUNCE_SECONDS=15
WHATSAPP_IMAGE_SESSION_TTL_MINUTES=10
WHATSAPP_RECOGNITION_TIMEOUT_SECONDS=90
WHATSAPP_RECOGNITION_POLL_SECONDS=2
WHATSAPP_WORKER_CONCURRENCY=4

# Catalog (OE / vehicle / radiator specs) lives in app tables and is maintained
# via Admin Excel import after the API creates the schema on startup.

RETRIEVAL_ENABLED=true
EMBEDDING_BACKEND=dinov2
EMBEDDING_MODEL_ID=facebook/dinov2-base
VECTOR_BACKEND=memory
SEARCH_INDEX_DIR=/data/indexes
# Photo360 root: category/SKU/r*.jpg. Leave empty to hide the 360 comparison images.
PHOTO360_ROOT=
# Optional second dump. Foreground queries use it; full-frame fallback keeps SEARCH_INDEX_DIR.
SEARCH_WHITE_INDEX_DIR=
SEARCH_AGGREGATE=topm_mean
SEARCH_TOPM=3
SEARCH_PER_IMAGE_TOP_K=30
SEARCH_HIGH_SCORE=0.72
SEARCH_MEDIUM_SCORE=0.55
SEARCH_MIN_MARGIN=0.03
SEARCH_CATEGORY_MIN_SCORE=0.55
SEARCH_CATEGORY_TOP_N=5
SEARCH_CATEGORY_RELATIVE_FLOOR=0.85
SEARCH_VISION_CATEGORY_MIN_CONFIDENCE=0.6
SEARCH_ENABLE_DUAL_PATH=false
SEARCH_TARGET_SIZE=224
SEARCH_ENABLE_FOREGROUND=true
SEARCH_SEGMENT_ENABLED=true
SEARCH_MATTING_MODEL_ID=ZhengPeng7/BiRefNet
SEARCH_MATTING_INPUT_SIZE=1024
SEARCH_SEGMENT_DEVICE=cuda
HF_HOME=/data/models

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-admin-password
ADMIN_DISPLAY_NAME=系统管理员

# Host ports published by Nginx.
H5_PORT=80
ADMIN_PORT=8080
WEB_PORT=8081

# RTX 5060 Ti is Blackwell and needs a CUDA 12.8 PyTorch wheel.
# A machine without this GPU can use the CPU wheel instead:
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
# SEARCH_SEGMENT_DEVICE=cpu
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
PIP_INDEX_URL=https://pypi.org/simple
IMAGE_TAG=local
