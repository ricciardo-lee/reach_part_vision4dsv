# Build the H5, desktop web, and admin frontends, then serve them with Nginx.
# npm dependencies are installed in this image build. Do not npm install in a running container.

FROM node:22-alpine AS h5
WORKDIR /src
COPY frontend-h5/package.json frontend-h5/package-lock.json ./
RUN npm ci
COPY frontend-h5/ ./
RUN npm run build

FROM node:22-alpine AS web
WORKDIR /src
COPY frontend-web/package.json frontend-web/package-lock.json ./
RUN npm ci
COPY frontend-web/ ./
RUN npm run build

FROM node:22-alpine AS admin
WORKDIR /src
COPY frontend-admin/package.json frontend-admin/package-lock.json ./
RUN npm ci
COPY frontend-admin/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/nginx.conf
COPY --from=h5 /src/dist /usr/share/nginx/h5
COPY --from=web /src/dist /usr/share/nginx/web
COPY --from=admin /src/dist /usr/share/nginx/admin
EXPOSE 80 8080 8081
