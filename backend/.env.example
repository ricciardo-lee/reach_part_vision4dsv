# Application
APP_NAME="Reach Part Vision"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS='["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174"]'

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# MySQL (独立库，禁止使用 ReachMDM_LMR)
MYSQL_HOST=192.168.5.235
MYSQL_PORT=3306
MYSQL_USER=admin
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=reach_part_vision4dsv

# Redis / Celery（本地，推荐异步识别）
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
# 推荐 true：识别走 Celery 异步，必须同时启动 worker
CELERY_ENABLED=true
# true=无 worker 时降级同步；生产建议 false
CELERY_ALLOW_INLINE_FALLBACK=false

# 对象存储：本地用磁盘，线上用 MinIO
# STORAGE_BACKEND=auto 时，APP_ENV!=production 走本地 uploads/，production 走 MinIO
# 线上请设 APP_ENV=production 或 STORAGE_BACKEND=minio
STORAGE_BACKEND=minio
LOCAL_STORAGE_DIR=uploads
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=part-vision
MINIO_SECURE=false
MINIO_PUBLIC_BASE_URL=

# DeepSeek Vision
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2

# MDM Query Service（只读；Client Credentials 换取短期 Bearer Token）
# 必须指向独立 mdm-query-service，不要填 MDM 管理 API 或本识图服务的 8000。
MDM_QUERY_BASE_URL=http://127.0.0.1:8010
MDM_CLIENT_ID=reach-part-vision
MDM_CLIENT_SECRET=replace-with-issued-secret
MDM_QUERY_TIMEOUT_SECONDS=30
# 首次请求之外最多重试次数；仅网络错误和 5xx 会重试
MDM_QUERY_MAX_RETRIES=2
# Token 距离过期不足该秒数时主动刷新
MDM_TOKEN_REFRESH_SKEW_SECONDS=30
MDM_USE_MOCK=true
# 中国车目录类型，只允许 passenger / truck
MDM_VEHICLE_TYPE=passenger
# 车型级联可选国家筛选；空值表示不筛选
MDM_COUNTRY=

# Recognition / retention
MAX_UPLOAD_MB=10
MAX_IMAGES_PER_SESSION=8
IMAGE_RETENTION_DAYS=30
DEVICE_SESSION_TTL_HOURS=72
RATE_LIMIT_PER_MINUTE=30
# 置信度低于该阈值计为拒识（评测）
EVAL_REJECT_CONFIDENCE=0.45

# 360 SKU retrieval (DINOv2 + Qdrant)
RETRIEVAL_ENABLED=true
EMBEDDING_BACKEND=dinov2
EMBEDDING_MODEL_ID=facebook/dinov2-base
VECTOR_BACKEND=qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=parts_360_current
SEARCH_INDEX_DIR=data/indexes
SEARCH_INDEX_VERSION=
SEARCH_AGGREGATE=topm_mean
SEARCH_TOPM=3
SEARCH_PER_IMAGE_TOP_K=30
SEARCH_HIGH_SCORE=0.72
SEARCH_MEDIUM_SCORE=0.55
SEARCH_MIN_MARGIN=0.03
SEARCH_CATEGORY_MIN_SCORE=0.55
SEARCH_CATEGORY_TOP_N=5
SEARCH_CATEGORY_RELATIVE_FLOOR=0.85
SEARCH_VISION_CATEGORY_MIN_CONFIDENCE=0.6
SEARCH_ENABLE_DUAL_PATH=false
SEARCH_TARGET_SIZE=224
SEARCH_ENABLE_FOREGROUND=true
SEARCH_SEGMENT_ENABLED=true
SEARCH_MATTING_MODEL_ID=ZhengPeng7/BiRefNet
SEARCH_MATTING_INPUT_SIZE=1024
SEARCH_SEGMENT_DEVICE=auto
SEARCH_SEGMENT_MIN_AREA=0.02
SEARCH_SEGMENT_MAX_AREA=0.92
SEARCH_SEGMENT_CROP_MARGIN=0.05
CELERY_WORKER_CONCURRENCY=1

# Default admin (created on init if missing)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
ADMIN_DISPLAY_NAME="系统管理员"
