# Application
APP_NAME="Reach Part Vision"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS='["http://localhost:5173","http://localhost:5174","http://localhost:5175","http://127.0.0.1:5173","http://127.0.0.1:5174","http://127.0.0.1:5175"]'

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# MySQL (独立库，禁止使用 ReachMDM_LMR)
MYSQL_HOST=192.168.5.235
MYSQL_PORT=3306
MYSQL_USER=admin
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=reach_part_vision4dsv

# Redis / Celery（本地，推荐异步识别）
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
# 推荐 true：识别走 Celery 异步，必须同时启动 worker
CELERY_ENABLED=true
# true=无 worker 时降级同步；生产建议 false
CELERY_ALLOW_INLINE_FALLBACK=false

# 对象存储：本地用磁盘，线上用 MinIO
# STORAGE_BACKEND=auto 时，APP_ENV!=production 走本地 uploads/，production 走 MinIO
# 线上请设 APP_ENV=production 或 STORAGE_BACKEND=minio
STORAGE_BACKEND=minio
LOCAL_STORAGE_DIR=uploads
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=part-vision
MINIO_SECURE=false
MINIO_PUBLIC_BASE_URL=

# OpenAI-compatible vision/chat (default: OpenAI). Names stay DEEPSEEK_* for compatibility.
# To use DeepSeek.com: BASE_URL=https://api.deepseek.com and DeepSeek model ids.
DEEPSEEK_API_KEY=sk-your-openai-api-key
DEEPSEEK_BASE_URL=https://api.openai.com/v1
DEEPSEEK_MODEL=gpt-4o
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_CHAT_MODEL=gpt-4o
DEEPSEEK_CHAT_MAX_TOOL_ROUNDS=4

# Meta WhatsApp Cloud API
# Local test: ngrok http 8000 → Callback URL = https://<ngrok-host>/sms/whatsapp/<WHATSAPP_WEBHOOK_PATH_TOKEN>
WHATSAPP_ENABLED=false
WHATSAPP_WEBHOOK_PATH_TOKEN=3ffcb52b3d3140c6933dde80b43cafa8
WHATSAPP_VERIFY_TOKEN=reach-use
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_RATE_LIMIT_PER_MINUTE=10
WHATSAPP_CONTEXT_MESSAGES=20
WHATSAPP_CONVERSATION_IDLE_HOURS=24
WHATSAPP_IMAGE_DEBOUNCE_SECONDS=15
WHATSAPP_IMAGE_SESSION_TTL_MINUTES=10
WHATSAPP_RECOGNITION_TIMEOUT_SECONDS=90
WHATSAPP_RECOGNITION_POLL_SECONDS=2
# If media download fails with SSL/EOF in China, point this at your local proxy:
# WHATSAPP_HTTP_PROXY=http://127.0.0.1:7890
WHATSAPP_HTTP_PROXY=
WHATSAPP_HTTP_RETRIES=3
# H5 site root for WhatsApp photo-result 360° deep links (empty = omit link).
# Local: build with `cd frontend-h5 && npm run build:h5`, then use the same ngrok as API + /h5
# Example: https://fragile-strung-gully.ngrok-free.dev/h5
WHATSAPP_H5_BASE_URL=
WHATSAPP_SHARED_APP_USER_USERNAME=Lee
WHATSAPP_SHARED_APP_USER_PASSWORD=123456

# 产品目录（OE / 车型 / 散热器规格）由后台 Excel 导入到本库自有表维护。

# Recognition / retention
MAX_UPLOAD_MB=10
MAX_IMAGES_PER_SESSION=8
IMAGE_RETENTION_DAYS=30
DEVICE_SESSION_TTL_HOURS=72
# 匿名创建设备会话（旧接口）。请保持 false，前端已改用账号 JWT 登录
ALLOW_ANONYMOUS_DEVICE_SESSION=false
# 每个识别用户每分钟最多启动的识别次数
RATE_LIMIT_PER_MINUTE=30
# 登录限流：同一 IP / 同一用户名每分钟最多尝试次数（H5/Web + 管理后台共用）
LOGIN_RATE_LIMIT_PER_MINUTE_IP=20
LOGIN_RATE_LIMIT_PER_MINUTE_USER=10
# 置信度低于该阈值计为拒识（评测）
EVAL_REJECT_CONFIDENCE=0.45

# 360 SKU retrieval (DINOv2 + Qdrant)
RETRIEVAL_ENABLED=true
EMBEDDING_BACKEND=dinov2
EMBEDDING_MODEL_ID=facebook/dinov2-base
VECTOR_BACKEND=qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=parts_360_current
# Photo360 root used to show catalog images next to the user's upload. Example: /data/Photo360
PHOTO360_ROOT=
SEARCH_INDEX_DIR=data/indexes
# BiRefNet white-cutout dump. Leave empty until that index has been built.
SEARCH_WHITE_INDEX_DIR=
SEARCH_INDEX_VERSION=
SEARCH_AGGREGATE=topm_mean
SEARCH_TOPM=3
SEARCH_PER_IMAGE_TOP_K=30
SEARCH_HIGH_SCORE=0.72
SEARCH_MEDIUM_SCORE=0.55
SEARCH_MIN_MARGIN=0.03
SEARCH_CATEGORY_MIN_SCORE=0.55
SEARCH_CATEGORY_TOP_N=5
SEARCH_CATEGORY_RELATIVE_FLOOR=0.85
SEARCH_VISION_CATEGORY_MIN_CONFIDENCE=0.6
SEARCH_ENABLE_DUAL_PATH=false
SEARCH_TARGET_SIZE=224
SEARCH_ENABLE_FOREGROUND=true
SEARCH_SEGMENT_ENABLED=true
SEARCH_MATTING_MODEL_ID=ZhengPeng7/BiRefNet
SEARCH_MATTING_INPUT_SIZE=1024
SEARCH_SEGMENT_DEVICE=auto
SEARCH_SEGMENT_MIN_AREA=0.02
SEARCH_SEGMENT_MAX_AREA=0.92
SEARCH_SEGMENT_CROP_MARGIN=0.05
CELERY_WORKER_CONCURRENCY=1

# Default admin (created on init if missing)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
ADMIN_DISPLAY_NAME="系统管理员"
