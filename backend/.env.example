# Application
APP_NAME="Reach Part Vision"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS='["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174"]'

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# MySQL (独立库，禁止使用 ReachMDM_LMR)
MYSQL_HOST=192.168.5.235
MYSQL_PORT=3306
MYSQL_USER=admin
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=reach_part_vision4dsv

# Redis / Celery（本地，推荐异步识别）
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
# 推荐 true：识别走 Celery 异步，必须同时启动 worker
CELERY_ENABLED=true
# true=无 worker 时降级同步；生产建议 false
CELERY_ALLOW_INLINE_FALLBACK=false

# MinIO
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=part-vision
MINIO_SECURE=false
STORAGE_BACKEND=auto
LOCAL_STORAGE_DIR=uploads
MINIO_PUBLIC_BASE_URL=

# DeepSeek Vision
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2

# MDM API (只读适配，对接 Reach MDM manage 接口)
# 关闭 Mock 前请配置有效 token（请求头 token，非 Bearer），并确保账号具备：
# GET /api/manage/cars/option_list
# POST /api/manage/products/check_product_exist
# POST /api/manage/cn_vehicle/search
# 必须指向 Reach MDM API（默认 9999），不要填本识图服务的 8000
MDM_API_BASE_URL=http://127.0.0.1:9999
# Reach MDM 请求头 token（非 Bearer）。本地开发可用 dev；正式环境填登录后的 JWT
MDM_API_TOKEN=dev
MDM_TIMEOUT_SECONDS=30
MDM_USE_MOCK=true
# 仅用于 cn_vehicle/search；option_list 的车型分类值为 PC / Passenger Cars 等，勿填 passenger
MDM_VEHICLE_TYPE=passenger
MDM_COUNTRY=

# Recognition / retention
MAX_UPLOAD_MB=10
MAX_IMAGES_PER_SESSION=4
IMAGE_RETENTION_DAYS=30
DEVICE_SESSION_TTL_HOURS=72
RATE_LIMIT_PER_MINUTE=30
# 置信度低于该阈值计为拒识（评测）
EVAL_REJECT_CONFIDENCE=0.45

# Default admin (created on init if missing)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
ADMIN_DISPLAY_NAME="系统管理员"
